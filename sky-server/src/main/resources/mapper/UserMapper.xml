<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.UserMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into user (openid, create_time)
        values (#{openid}, #{createTime})
    </insert>

    <select id="countUser" resultType="java.lang.Integer">
        select count(*) from user
                        <where>
                            <if test="beginTime != null">
                                and create_time &gt;= #{beginTime}
                            </if>
                            <if test="endTime != null">
                                and create_time &lt;= #{endTime}
                            </if>
                        </where>
    </select>

    <select id="countNewUserByDay" resultType="map">
        select DATE(create_time) as date, count(*) as count
        from user
        where create_time &gt;= #{beginTime}
          and create_time &lt;= #{endTime}
        group by DATE(create_time)
    </select>

    <select id="countUserBefore" resultType="java.lang.Integer">
        select count(*) from user where create_time &lt; #{beginTime}
    </select>
</mapper>